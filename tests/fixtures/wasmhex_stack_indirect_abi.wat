(module
  (type $callee_type (func (param i64 i64 i64 i64)))
  (import "env" "table" (table 1 1 funcref))
  (func $callee (type $callee_type)
    (local.get 0)
    (local.get 1)
    (i64.add)
    (local.get 2)
    (i64.add)
    (local.get 3)
    (i64.add)
    (drop)
  )
  (elem (table 0) (i32.const 0) func $callee)
  (func (export "caller") (param i64 i64 i64 i64 i32)
    (local.get 0)
    (local.get 1)
    (local.get 2)
    (local.get 3)
    (local.get 4)
    (call_indirect (type $callee_type))
  )
)
