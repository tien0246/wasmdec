(module
  (memory (export "memory") 1)
  (func (export "shl_bool_value") (param $v i64) (result i64)
    ;; i64.shl with a boolean VALUE: eq -> i32 (0/1) -> extend_u -> i64
    (i64.shl (i64.extend_i32_u (i64.eq (local.get $v) (i64.const 45)))
             (i64.const 63)))
  (func (export "shl_i32_count") (param $v i64) (param $c i32) (result i64)
    ;; non-constant i32 count widened to i64 (dynamic count path)
    (i64.shl (local.get $v) (i64.extend_i32_u (local.get $c))))
  (func (export "div_u64") (param $a i64) (param $b i64) (result i64)
    (i64.div_u (local.get $a) (local.get $b)))
  (func (export "rem_u64") (param $a i64) (param $b i64) (result i64)
    (i64.rem_u (local.get $a) (local.get $b)))
  (func (export "div_u32") (param $a i32) (param $b i32) (result i32)
    (i32.div_u (local.get $a) (local.get $b)))
  (func (export "rem_u32") (param $a i32) (param $b i32) (result i32)
    (i32.rem_u (local.get $a) (local.get $b)))
  (func (export "shr_mix") (param $v i64) (result i64)
    ;; i64.shr_u with a boolean count (0/1 -> 63 masked count)
    (i64.shr_u (local.get $v)
               (i64.extend_i32_u (i64.eq (local.get $v) (i64.const 45)))))
  (func (export "shr_s_i64") (param $v i64) (param $c i32) (result i64)
    (i64.shr_s (local.get $v) (i64.extend_i32_u (local.get $c))))
)
