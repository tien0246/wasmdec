(module
  (func $callee (export "callee") (param i64 i64 i64 i64)
    (local.get 0)
    (i64.add (local.get 1))
    (i64.add (local.get 2))
    (i64.add (local.get 3))
    (drop)
  )
  (func (export "caller") (param i64 i64 i64 i64)
    (local.get 0)
    (local.get 1)
    (local.get 2)
    (local.get 3)
    (call $callee)
  )
)
