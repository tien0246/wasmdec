(module
  (type $sig (func (result i32)))
  (import "env" "b" (table $b 2 funcref))
  (table $d 1 funcref)
  (table $e 1 funcref)
  (func $d_func (type $sig) (i32.const 22))
  (func $e_func (type $sig) (i32.const 44))
  (func $pass_func (type $sig) (i32.const 33))
  (elem (table $d) (i32.const 0) func $d_func)
  (elem (table $e) (i32.const 0) func $e_func)
  (elem $pass func $pass_func)
  (func $read_b2 (export "read_b2") (result i32)
    (i32.const 0) (call_indirect $b (type $sig)))
  (func $read_b_passive (export "read_b_passive") (result i32)
    (i32.const 1) (call_indirect $b (type $sig)))
  (func $read_d (export "read_d") (result i32)
    (i32.const 0) (call_indirect $d (type $sig)))
  (func $read_e (export "read_e") (result i32)
    (i32.const 0) (call_indirect $e (type $sig)))
  (func $install_passive (export "install_passive")
    (i32.const 1) (i32.const 0) (i32.const 1)
    (table.init $b $pass)
    (elem.drop $pass))
  (func $touch_tables (export "touch_tables")
    (i32.const 0) (table.get $b) (drop)
    (i32.const 0) (ref.null func) (table.set $b)
    (i32.const 0) (i32.const 0) (i32.const 0) (table.copy $b $d)
    (i32.const 0) (ref.null func) (i32.const 0) (table.fill $b)
    (table.size $b) (drop)
    (ref.null func) (i32.const 0) (table.grow $b) (drop))
  (export "table_b2" (table 0))
  (export "table_d" (table 1))
  (export "table_e" (table 2)))
