# Dependency-graph gate (pure CMake script): regenerates the CMake
# graphviz dump and asserts the one-directional module layout:
#   wasmhex_binary     (SDK-free, depends on nothing but the STL)
#   wasmhex_validation (SDK-free, depends only on wasmhex_binary)
#   wasmhex_analysis   (SDK-free, depends only on binary + validation)
#   wasmhex_debuginfo  (SDK-free, depends only on the core libs above)
#   wasmdec / wasmdecldr (SDK) may depend on all of them — never the reverse.
# Any edge going the other way, or any SDK link on the two core libraries,
# fails the build with the offending edge printed.
# Invocation:
#   cmake -DBUILD_DIR=<build-dir> -P tools/dep_check.cmake
#   or:
#   cmake -P tools/dep_check.cmake <build-dir>

if(NOT DEFINED BUILD_DIR OR "${BUILD_DIR}" STREQUAL "")
  set(_found_p FALSE)
  math(EXPR _last_arg "${CMAKE_ARGC} - 1")
  foreach(_idx RANGE 0 ${_last_arg})
    set(_arg "${CMAKE_ARGV${_idx}}")
    if(_found_p AND NOT "${_arg}" MATCHES "^-")
      set(BUILD_DIR "${_arg}")
      break()
    endif()
    if("${_arg}" STREQUAL "-P")
      # Next argument is the script path itself; the one after that is <build-dir>.
      math(EXPR _after_script "${_idx} + 2")
      if(_after_script LESS CMAKE_ARGC)
        set(BUILD_DIR "${CMAKE_ARGV${_after_script}}")
        break()
      endif()
    endif()
  endforeach()
endif()

if(NOT DEFINED BUILD_DIR OR "${BUILD_DIR}" STREQUAL "")
  message(FATAL_ERROR "dep_check: pass -DBUILD_DIR=<build-dir> or <build-dir> after -P tools/dep_check.cmake")
endif()

set(_cache_file "${BUILD_DIR}/CMakeCache.txt")
if(NOT EXISTS "${_cache_file}")
  message(FATAL_ERROR "dep_check: ${_cache_file} does not exist")
endif()

file(STRINGS "${_cache_file}" _home_lines REGEX "^CMAKE_HOME_DIRECTORY:INTERNAL=")
if(NOT _home_lines)
  message(FATAL_ERROR "dep_check: cannot find CMAKE_HOME_DIRECTORY in ${_cache_file}")
endif()
list(GET _home_lines 0 _home_line)
string(REGEX REPLACE "^CMAKE_HOME_DIRECTORY:INTERNAL=" "" _home "${_home_line}")
if("${_home}" STREQUAL "")
  message(FATAL_ERROR "dep_check: empty CMAKE_HOME_DIRECTORY in ${_cache_file}")
endif()

set(_dot_file "${BUILD_DIR}/deps.dot")
execute_process(
  COMMAND "${CMAKE_COMMAND}" "${_home}" -B "${BUILD_DIR}" "--graphviz=${_dot_file}"
  RESULT_VARIABLE _rc
  OUTPUT_VARIABLE _out
  ERROR_VARIABLE _err)
if(NOT _rc EQUAL 0)
  message(FATAL_ERROR "dep_check: cmake graphviz generation failed (rc=${_rc})\n${_err}")
endif()

if(NOT EXISTS "${_dot_file}")
  message(FATAL_ERROR "dep_check: graphviz file ${_dot_file} was not created")
endif()

file(STRINGS "${_dot_file}" _dot_lines)
set(_core_targets "wasmhex_binary" "wasmhex_validation" "wasmhex_analysis" "wasmhex_debuginfo" "wasmhex_component")
set(_sdk_targets "wasmdec" "wasmdecldr" "idasdk" "hexrays")
set(_bad_edges "")

function(_wasmhex_is_sdk_target name out_var)
  set(_in_sdk FALSE)
  foreach(_s IN LISTS _sdk_targets)
    if("${name}" STREQUAL "${_s}")
      set(_in_sdk TRUE)
      break()
    endif()
  endforeach()
  if(NOT _in_sdk)
    set(${out_var} FALSE PARENT_SCOPE)
    return()
  endif()
  foreach(_c IN LISTS _core_targets)
    if("${name}" STREQUAL "${_c}" OR "${name}" MATCHES "_${_c}$")
      set(${out_var} FALSE PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${out_var} TRUE PARENT_SCOPE)
endfunction()

foreach(_line IN LISTS _dot_lines)
  string(STRIP "${_line}" _trimmed)
  if(NOT "${_trimmed}" MATCHES "->" OR NOT "${_trimmed}" MATCHES "//")
    continue()
  endif()
  string(REGEX REPLACE "^.*//[ \t]*" "" _comment "${_trimmed}")
  if(NOT "${_comment}" MATCHES "^(.+)->(.+)$")
    continue()
  endif()
  string(REGEX REPLACE "^(.*)->.*$" "\\1" _raw_src "${_comment}")
  string(REGEX REPLACE "^.*->(.*)$" "\\1" _raw_dst "${_comment}")
  string(STRIP "${_raw_src}" _raw_src)
  string(STRIP "${_raw_dst}" _raw_dst)
  string(REGEX REPLACE "::.*$" "" _src "${_raw_src}")
  string(REGEX REPLACE "::.*$" "" _dst "${_raw_dst}")

  _wasmhex_is_sdk_target("${_dst}" _dst_is_sdk)

  if("${_src}" STREQUAL "wasmhex_binary")
    if(_dst_is_sdk)
      list(APPEND _bad_edges "${_src} -> ${_dst} (core library must stay SDK-free)")
    endif()
    if("${_dst}" STREQUAL "wasmhex_validation")
      list(APPEND _bad_edges "${_src} -> ${_dst} (reverse edge: binary must not see validation)")
    endif()
    if("${_dst}" STREQUAL "wasmhex_analysis")
      list(APPEND _bad_edges "${_src} -> ${_dst} (reverse edge: binary must not see analysis)")
    endif()
  elseif("${_src}" STREQUAL "wasmhex_validation")
    if(_dst_is_sdk)
      list(APPEND _bad_edges "${_src} -> ${_dst} (core library must stay SDK-free)")
      if(NOT "${_dst}" STREQUAL "wasmhex_binary")
        list(APPEND _bad_edges "${_src} -> ${_dst} (validation may only depend on binary)")
      endif()
    endif()
    if("${_dst}" STREQUAL "wasmhex_analysis")
      list(APPEND _bad_edges "${_src} -> ${_dst} (reverse edge: validation must not see analysis)")
    endif()
  elseif("${_src}" STREQUAL "wasmhex_analysis")
    if(_dst_is_sdk)
      list(APPEND _bad_edges "${_src} -> ${_dst} (core library must stay SDK-free)")
      if(NOT "${_dst}" STREQUAL "wasmhex_binary" AND NOT "${_dst}" STREQUAL "wasmhex_validation")
        list(APPEND _bad_edges "${_src} -> ${_dst} (analysis may only depend on binary/validation)")
      endif()
    endif()
  elseif("${_src}" STREQUAL "wasmhex_debuginfo" OR "${_src}" STREQUAL "wasmhex_component")
    if(_dst_is_sdk)
      list(APPEND _bad_edges "${_src} -> ${_dst} (core library must stay SDK-free)")
      if(NOT "${_dst}" STREQUAL "wasmhex_binary" AND NOT "${_dst}" STREQUAL "wasmhex_validation"
         AND NOT "${_dst}" STREQUAL "wasmhex_analysis")
        list(APPEND _bad_edges "${_src} -> ${_dst} (may only depend on binary/validation/analysis)")
      endif()
    endif()
  endif()
endforeach()

if(_bad_edges)
  list(REMOVE_DUPLICATES _bad_edges)
  list(SORT _bad_edges)
  message(STATUS "dep_check: FORBIDDEN dependencies:")
  foreach(_b IN LISTS _bad_edges)
    message(STATUS "  ${_b}")
  endforeach()
  message(FATAL_ERROR "dep_check failed")
endif()

message(STATUS "dep_check: OK — wasmhex_binary/validation/analysis stay SDK-free and one-directional")
